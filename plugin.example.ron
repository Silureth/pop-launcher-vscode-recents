(
    name: "VS Code open recent",
    description: "Open a recent VS Code folder or workspace\nSyntax: vc <search>",
    bin: (path: "vscode-open-recent"),
    icon: Name("<plugin-folder>/assets/plugin.svg"),
    query: (
        regex: "^(vc)",
        help: "vc",
        isolate: true,
        no_sort: true,
        history: false
    ),
)
